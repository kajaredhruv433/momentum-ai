# Add one or more Groq API keys as GROQ_API_KEY_1, GROQ_API_KEY_2, etc.
GROQ_API_KEY_1=your-groq-api-key
GROQ_TPM_LIMIT=6000
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_TOKEN_SAFETY_MARGIN=500

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Fallback if a panel member has no assigned voice; panel voices are in backend/voice.py.
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=echosphere
MONGODB_INTERVIEW_COLLECTION=interviews

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_RESUME_COLLECTION=resumes
QDRANT_QUESTIONS_COLLECTION=questions
QDRANT_KNOWLEDGE_COLLECTION=knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
