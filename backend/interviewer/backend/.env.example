# Add one or more Groq API keys as GROQ_API_KEY_1, GROQ_API_KEY_2, etc.
GROQ_API_KEY_1=your-groq-api-key
GROQ_TPM_LIMIT=6000
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_TOKEN_SAFETY_MARGIN=500

AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=echosphere
MONGODB_INTERVIEW_COLLECTION=interviews

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_RESUME_COLLECTION=resumes
QDRANT_QUESTIONS_COLLECTION=questions
QDRANT_KNOWLEDGE_COLLECTION=knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2