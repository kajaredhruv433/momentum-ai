# Baseten LLM API
BASETEN_API_KEY=your-baseten-api-key
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_MAX_OUTPUT_TOKENS=2048
BASETEN_REASONING_EFFORT=low

# GitHub App OAuth. Keep the client secret on the backend only.
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
GITHUB_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ElevenLabs Speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=momentum
MONGODB_INTERVIEW_COLLECTION=interview
