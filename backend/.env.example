# Gemini API Keys & Settings
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_RPM_LIMIT=5
GEMINI_RPD_LIMIT=20
GEMINI_TPM_LIMIT=1000000
GEMINI_TOKEN_SAFETY_MARGIN=0.90

# Groq API Keys & Settings
GROQ_API_KEY_1=your-groq-api-key-1
GROQ_API_KEY_2=your-groq-api-key-2
GROQ_TPM_LIMIT=8000
GROQ_MAX_OUTPUT_TOKENS=1000
GROQ_TOKEN_SAFETY_MARGIN=0.90

# ElevenLabs Speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=momentum
MONGODB_INTERVIEW_COLLECTION=interview

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_RESUME_COLLECTION=resume_chunks
QDRANT_QUESTIONS_COLLECTION=interview_questions
QDRANT_KNOWLEDGE_COLLECTION=interview_knowledge

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
