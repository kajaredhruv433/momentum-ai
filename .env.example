# ==============================================================================
# Momentum & EchoSphere Unified Configuration Template
# ==============================================================================

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/momentum
MONGODB_DATABASE=momentum
DB_NAME=momentum

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Google Gemini API Keys
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2

# Groq Cloud API Keys (Multi-Key Load Balancing for AI Panel Agents)
GROQ_API_KEY_1=your-groq-api-key-1
GROQ_API_KEY_2=your-groq-api-key-2
GROQ_TPM_LIMIT=6000
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_TOKEN_SAFETY_MARGIN=500

# Agora Conversational AI & Real-Time Communication
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_AGENT_UID=9001
AGORA_VOICE_PRESET=minimax_speech_2_6_turbo
AGORA_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-if-using-openai-llm

# Qdrant Vector Database (for semantic matching & resume retrieval)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_RESUME_COLLECTION=resumes
QDRANT_QUESTIONS_COLLECTION=questions
QDRANT_KNOWLEDGE_COLLECTION=knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
