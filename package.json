{
  "name": "momentum",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:interviewer": "npm --prefix frontend/interviewer run dev",
    "dev:backend": "backend\\venv\\Scripts\\python.exe -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "start:backend": "backend\\venv\\Scripts\\python.exe -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "build:frontend": "npm --prefix frontend run build",
    "build:interviewer": "npm --prefix frontend/interviewer run build"
  }
}
